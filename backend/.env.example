# Copy this file to .env and set real values before starting the backend.
PORT=5000
MONGO_URI=mongodb://localhost:27017/preschool
JWT_SECRET=replace-with-a-long-random-secret
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_FROM=
FRONTEND_URL=http://localhost:5173
# Public API origin used to create private photo URLs. Set to the HTTPS API origin in production.
API_PUBLIC_URL=http://localhost:5000
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Optional SMTP delivery for expiring staff/parent invitation links.
# Without SMTP, the authorized inviter receives a copyable one-time link.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_FROM=
# Reuse EMAIL_USER and EMAIL_PASS above for SMTP authentication.

# SaaS self-service registration must remain disabled until all core routes
# and private child-media delivery have tenant-scoped access and passing tests.
ENABLE_SAAS_REGISTRATION=false
SAAS_TENANT_DATA_READY=false
