# Copy this file to .env and set real values before starting the backend.
PORT=5000
# Set to the exact trusted reverse-proxy hop count for your host (never use 1 by guess).
TRUST_PROXY_HOPS=0
MONGO_URI=mongodb://localhost:27017/preschool
JWT_SECRET=replace-with-a-long-random-secret
# Separate secret for short-lived private media links (at least 32 random characters).
PRIVATE_MEDIA_SECRET=replace-with-a-different-long-random-secret

# Single-preschool parent access. Set the actual school name for the generated family URL.
SINGLE_SCHOOL_NAME=Your Preschool Name

# Frontend and public API origins. In production, use canonical HTTPS origins.
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

# SMTP is optional locally and required in production for password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_FROM=
EMAIL_USER=
EMAIL_PASS=

# First administrator bootstrap: set all three together for the first start only.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
