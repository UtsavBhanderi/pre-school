# Copy this file to .env and set real values before starting the backend.
PORT=5000
MONGO_URI=mongodb://localhost:27017/preschool
JWT_SECRET=replace-with-a-long-random-secret
EMAIL_USER=
EMAIL_PASS=
FRONTEND_ORIGIN=http://localhost:5173

# SaaS self-service registration must remain disabled until all core routes
# and private child-media delivery have tenant-scoped access and passing tests.
ENABLE_SAAS_REGISTRATION=false
SAAS_TENANT_DATA_READY=false
