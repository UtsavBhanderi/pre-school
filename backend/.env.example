# Copy this file to .env and set real values before starting the backend.
PORT=5000
MONGO_URI=mongodb://localhost:27017/preschool
JWT_SECRET=replace-with-a-long-random-secret
# Separate secret for tenant-scoped, short-lived private media links (at least 32 random characters).
PRIVATE_MEDIA_SECRET=replace-with-a-different-long-random-secret

# Frontend and public API origins. In production, use canonical HTTPS origins.
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

# SMTP delivery is required for password recovery, email verification and invitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_FROM=
EMAIL_USER=
EMAIL_PASS=

# SaaS self-service signup remains disabled by default. Keep both flags false until
# legacy-data migration, tenant APIs, private media and integration checks are signed off.
ENABLE_SAAS_REGISTRATION=false
SAAS_TENANT_DATA_READY=false

# Legacy data migration is dry-run by default. Apply is blocked outside staging.
SAAS_MIGRATION_ENV=local
ALLOW_LEGACY_TENANT_MIGRATION=false

# Verified staff identity migration is dry-run by default and staging-only.
ALLOW_LEGACY_STAFF_MIGRATION=false
