# Copy this file to .env and set real values before starting the backend.
PORT=5000
MONGO_URI=mongodb://localhost:27017/preschool
JWT_SECRET=replace-with-a-long-random-secret

# Frontend and public API origins. In production, use the canonical HTTPS origins.
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

# Optional SMTP delivery for expiring staff/parent invitation links.
# Without SMTP, the authorized inviter receives a copyable one-time link.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_FROM=
EMAIL_USER=
EMAIL_PASS=

# SaaS self-service registration must remain disabled until every core route,
# child-media delivery path, and tenant-isolation test has passed.
ENABLE_SAAS_REGISTRATION=false
SAAS_TENANT_DATA_READY=false
